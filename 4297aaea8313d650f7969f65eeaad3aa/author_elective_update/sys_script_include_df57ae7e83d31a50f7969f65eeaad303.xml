        <script><![CDATA[var LearnSphereUtils = Class.create();
LearnSphereUtils.prototype = {
    initialize: function() {
    },
	refInstructors: function() {
		var grRole = new GlideRecord('sys_user_has_role');
		grRole.addEncodedQuery('roles=x_1305322_learns_0.ls_course_instructor^active=true');
		grRole.query();

		var instructors = [];

		while(grRole.next()) {
			instructors.push(grRole.getValue('user'));
		}

		return 'sys_idIN' + instructors;
	},
    type: 'LearnSphereUtils'
};]]></script>
